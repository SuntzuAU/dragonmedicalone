---
import Theme from '../../components/Theme.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import site from '../../site.config.json';
import manifest from '../../data/image-manifest.json';
const c = site.colours;
const year = new Date().getFullYear();
const R2_BASE = import.meta.env.PUBLIC_R2_BASE || 'https://pub-c7a09e1ddb7c45e6a38fcdca1e4b6897.r2.dev';
function imgSrc(key) {
  if (!key || !R2_BASE) return '';
  const entry = manifest[key];
  if (entry?.r2Key) return `${R2_BASE.replace(/\/$/, '')}/${entry.r2Key}`;
  if (key.includes('/')) return `${R2_BASE.replace(/\/$/, '')}/${key}`;
  return '';
}
const posts = (await getCollection('news')).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>News - {site.siteName}</title>
  <meta name="description" content={`Latest news and articles about Dragon Medical One, clinical speech recognition, and healthcare documentation in Australia.`} />
  <link rel="canonical" href={`${site.domain}/news`} />
  {site.googleAnalyticsId && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}></script>
    <script define:vars={{ gaId: site.googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  )}
  <Theme />
  <style is:inline>
    .posts{display:grid;grid-template-columns:repeat(2,1fr);gap:40px 36px}
    .post-card{display:block}
    .post-img{aspect-ratio:16/9;border-radius:18px;overflow:hidden;background:#dfe5ec;margin-bottom:20px}
    .post-img img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
    .post-card:hover .post-img img{transform:scale(1.03)}
    .post-date{font-size:14px;color:#6b7a8f;margin-bottom:8px}
    .post-body h2{font-family:var(--serif);font-weight:500;font-size:28px;line-height:1.15;letter-spacing:-.015em;margin:0 0 10px}
    .post-card:hover h2{color:var(--green-deep)}
    .post-body p{color:var(--muted);font-size:16.5px;margin:0}
    .empty{color:var(--muted);font-size:17.5px}
    @media(max-width:760px){.posts{grid-template-columns:1fr}.post-body h2{font-size:24px}}
  </style>
</head>
<body>
  <SiteHeader />

  <main>
  <section class="page-hero">
    <div class="wrap">
      <a class="crumb" href="/">&larr; Back to {site.siteName}</a>
      <h1>News</h1>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      {posts.length === 0 ? (
        <div class="empty">No articles yet. Check back soon for the latest on Dragon Medical One and clinical speech recognition in Australia.</div>
      ) : (
        <div class="posts">
          {posts.map((post) => (
            <a href={`/news/${post.slug}`} class="post-card">
              {post.data.heroImage && imgSrc(post.data.heroImage) && (
                <div class="post-img"><img src={imgSrc(post.data.heroImage)} alt={post.data.heroImageAlt || post.data.title} loading="lazy" decoding="async" /></div>
              )}
              <div class="post-body">
                <div class="post-date">{post.data.date}</div>
                <h2>{post.data.title}</h2>
                <p>{post.data.metaDescription}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
  </main>

  <SiteFooter />
</body>
</html>
