---
import Theme from '../../components/Theme.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import site from '../../site.config.json';
import manifest from '../../data/image-manifest.json';
const c = site.colours;
const year = new Date().getFullYear();
const R2_BASE = import.meta.env.PUBLIC_R2_BASE || 'https://pub-c7a09e1ddb7c45e6a38fcdca1e4b6897.r2.dev';
function imgSrc(key) {
  if (!key || !R2_BASE) return '';
  const entry = manifest[key];
  if (entry?.r2Key) return `${R2_BASE.replace(/\/$/, '')}/${entry.r2Key}`;
  if (key.includes('/')) return `${R2_BASE.replace(/\/$/, '')}/${key}`;
  return '';
}
export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{d.title} - {site.siteName}</title>
  <meta name="description" content={d.metaDescription} />
  <link rel="canonical" href={`${site.domain}/news/${post.slug}`} />
  {site.googleAnalyticsId && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}></script>
    <script define:vars={{ gaId: site.googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  )}
  <Theme />
  <style is:inline>
    .article-hero h1{font-size:50px;max-width:820px}
    .meta{font-size:15px;color:rgba(255,255,255,.65)}
    .hero-img{border-radius:20px;overflow:hidden;aspect-ratio:16/9;background:#dfe5ec;margin:-56px 0 48px;position:relative;box-shadow:0 40px 80px -30px rgba(6,20,39,.5)}
    .hero-img img{width:100%;height:100%;object-fit:cover}
    .article-wrap{max-width:820px;margin:0 auto;padding:0 40px}
    article.prose{max-width:none}
    article.prose h2{font-size:34px}
    article.prose table{width:100%;border-collapse:collapse;margin:0 0 24px;font-size:16px}
    article.prose th{text-align:left;padding:12px 14px;background:var(--navy);color:#fff;font-weight:600}
    article.prose td{padding:12px 14px;border-bottom:1px solid var(--line);color:var(--muted)}
    article.prose img{border-radius:16px;margin:8px 0 24px}
    article.prose blockquote{margin:0 0 20px;padding:4px 0 4px 22px;border-left:3px solid var(--green-deep)}
    .no-img{height:56px}
    @media(max-width:900px){.article-wrap{padding:0 24px}.article-hero h1{font-size:38px}}
    @media(max-width:600px){.article-wrap{padding:0 20px}.article-hero h1{font-size:30px}.hero-img{margin:-36px 0 32px;border-radius:14px}}
  </style>
</head>
<body>
  <SiteHeader />

  <main>
  <section class="page-hero article-hero" style="padding-bottom:104px">
    <div class="article-wrap">
      <a class="crumb" href="/news">&larr; All news</a>
      <h1>{d.title}</h1>
      <div class="meta">{d.date}</div>
    </div>
  </section>

  <div class="article-wrap" style="padding-bottom:88px">
    {d.heroImage && imgSrc(d.heroImage) ? (
      <div class="hero-img"><img src={imgSrc(d.heroImage)} alt={d.heroImageAlt || d.title} loading="eager" decoding="async" /></div>
    ) : <div class="no-img"></div>}
    <article class="prose">
      <Content />
    </article>
  </div>
  </main>

  <SiteFooter />
</body>
</html>
