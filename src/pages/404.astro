---
import Theme from '../components/Theme.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import site from '../site.config.json';
const c = site.colours;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Page Not Found - {site.siteName}</title>
  <Theme />
  <style is:inline>
    .nf{min-height:60vh;display:flex;align-items:center;text-align:center}
    .nf h1{font-size:120px;margin-bottom:8px}
    .nf .btn{white-space:normal}
  </style>
</head>
<body>
  <SiteHeader />
  <main>
  <section class="page-hero center nf">
    <div class="wrap narrow">
      <h1>404</h1>
      <p>This page does not exist.</p>
      <div class="hero-btns"><a class="btn btn-primary btn-lg" href="/">Back to {site.siteName}</a></div>
    </div>
  </section>
  </main>
  <SiteFooter />
</body>
</html>
