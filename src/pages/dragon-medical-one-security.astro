---
import site from '../site.config.json';
import ACForm from '../components/ACForm.astro';
const c = site.colours;
const year = new Date().getFullYear();
const topic = site.infoPages.find(p => p.slug === 'dragon-medical-one-security');

// FAQPage schema for AI extractability
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": topic.faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Voice Recognition Australia",
  "url": "https://www.voicerecognition.com.au",
  "description": "Australian Dragon distributor since 1999. Healthcare, legal, government and enterprise speech recognition deployments.",
  "foundingDate": "1999",
  "sameAs": [
    "https://dragonprofessional16.com.au",
    "https://dragonnaturallyspeaking.com.au",
    "https://dragonmedicalone.au",
    "https://dictationsolutions.com.au",
    "https://cloudprinting.au",
    "https://pdfsoftware.com.au"
  ]
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{topic.title} | {site.siteName}</title>
  <meta name="description" content={topic.metaDescription} />
  <link rel="canonical" href={`${site.domain}/${topic.slug}`} />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  {site.googleAnalyticsId && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}></script>
    <script define:vars={{ gaId: site.googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  )}

  <style is:inline>
    *,*::before,*::after{box-sizing:border-box}
    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#0f172a;line-height:1.7}
    a{color:inherit}
    img{max-width:100%;display:block}
    .wrap{max-width:900px;margin:0 auto;padding:0 24px}

    header{position:sticky;top:0;background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-bottom:1px solid #e2e8f0;z-index:100}
    .nav{display:flex;align-items:center;justify-content:space-between;padding:10px 0;gap:16px;max-width:900px;margin:0 auto;padding-left:24px;padding-right:24px}
    .logo img{height:40px;width:auto}
    .nav-links{display:flex;gap:18px;font-size:14px;font-weight:500;color:#334155}
    .btn{display:inline-block;padding:10px 20px;border-radius:8px;font-weight:700;font-size:14px;border:2px solid transparent;cursor:pointer;text-decoration:none;white-space:nowrap}
    .btn-primary{background:#f59e0b;border-color:#f59e0b;color:#0f172a}
    .btn-primary:hover{background:#d97706;border-color:#d97706}
    .btn-secondary{background:white;border-color:#cbd5e1;color:#0c4a6e}
    .btn-lg{padding:14px 28px;font-size:16px;border-radius:10px}

    .back{display:inline-block;margin:20px 0 0;font-size:14px;font-weight:600;text-decoration:none;color:#0c4a6e}
    .back:hover{text-decoration:underline}

    .hero{padding:32px 0 24px}
    .hero-pill{display:inline-flex;align-items:center;background:#e0f2fe;border:1px solid #bae6fd;border-radius:999px;padding:6px 14px;font-size:13px;font-weight:600;color:#0c4a6e;margin-bottom:14px}
    .hero h1{font-size:38px;line-height:1.15;margin:0 0 16px;letter-spacing:-0.02em}
    .hero .lede{font-size:18px;color:#334155;margin:0 0 24px;line-height:1.6}

    .tldr{background:#f0f9ff;border-left:4px solid #0c4a6e;border-radius:8px;padding:20px 24px;margin:24px 0 32px}
    .tldr-label{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#0c4a6e;margin:0 0 8px}
    .tldr-body{font-size:16px;color:#0f172a;margin:0;line-height:1.6}

    section{padding:32px 0}
    section.alt{background:#f0f9ff;border-top:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0}
    h2{font-size:26px;letter-spacing:-0.02em;margin:0 0 14px}
    .content-block p{font-size:16px;color:#334155;margin:0 0 14px}
    .content-block ul{padding-left:22px;margin:0 0 16px}
    .content-block li{font-size:16px;color:#334155;margin-bottom:8px}

    /* Spec table - extractable, citation-friendly */
    .spec-table{width:100%;border-collapse:collapse;margin:18px 0;border:1px solid #e2e8f0;border-radius:10px;overflow:hidden}
    .spec-table th{text-align:left;padding:12px 16px;font-size:13px;font-weight:700;color:#0c4a6e;background:#f8fafc;border-bottom:1px solid #e2e8f0}
    .spec-table td{padding:12px 16px;font-size:15px;color:#334155;border-bottom:1px solid #f1f5f9;vertical-align:top}
    .spec-table tr:last-child td{border-bottom:none}
    .spec-table td.label{font-weight:700;color:#0f172a;background:#fafafa;width:36%}

    /* FAQ blocks - structured for AI extraction */
    .faq{margin:24px 0}
    .faq-item{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px 24px;margin-bottom:14px}
    .faq-item h3{margin:0 0 10px;font-size:17px;color:#0f172a;line-height:1.4}
    .faq-item p{margin:0;font-size:15px;color:#334155;line-height:1.7}

    /* Related topics navigation */
    .related-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:20px}
    .related-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:18px 20px;text-decoration:none;color:inherit;transition:border-color .15s,box-shadow .15s}
    .related-card:hover{border-color:#0c4a6e;box-shadow:0 4px 12px rgba(12,74,110,.08)}
    .related-card h4{margin:0 0 4px;font-size:15px;color:#0c4a6e}
    .related-card p{margin:0;font-size:13px;color:#64748b;line-height:1.5}

    /* CTA */
    .cta-section{background:linear-gradient(135deg,#0c4a6e,#0e7490);color:white;padding:48px 0}
    .cta-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}
    .cta-section h2{color:white;margin:0 0 12px}
    .cta-section p{color:#94a3b8;margin:0 0 16px;font-size:15px}

    footer{background:#0f172a;color:#64748b;padding:28px 0;font-size:14px}
    .footer-inner{max-width:900px;margin:0 auto;padding:0 24px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;align-items:center}
    .footer-links{display:flex;gap:20px}
    .footer-links a{color:#64748b;text-decoration:none}
    .footer-links a:hover{color:white}
    .footer-disclaimer{max-width:900px;margin:12px auto 0;padding:12px 24px 0;font-size:11px;color:#475569;line-height:1.6;border-top:1px solid #1e293b}

    @media(max-width:700px){
      .hero h1{font-size:28px}
      .related-grid{grid-template-columns:1fr}
      .cta-grid{grid-template-columns:1fr}
      .nav-links{display:none}
      .spec-table td.label{width:42%;font-size:13px}
      .spec-table td{font-size:14px;padding:10px 12px}
    }
  </style>
</head>
<body>

  <header>
    <div class="nav">
      <div class="logo"><a href="/"><img src="/logo.jpg" alt={site.siteName} /></a></div>
      <nav class="nav-links" aria-label="Primary">
        <a href="/#benefits">Benefits</a>
        <a href="/#comparison">Compare</a>
        <a href="/#faq">FAQ</a>
        <a href="/dragon-copilot">Copilot</a>
        <a href="/#final-cta">Contact</a>
      </nav>
      <a class="btn btn-primary" href="/#final-cta">Request Free Trial</a>
    </div>
  </header>

  <div class="wrap">
    <a class="back" href="/">&larr; Back to Dragon Medical One Australia</a>
  </div>

  <section class="hero">
    <div class="wrap">
      <div class="hero-pill">Dragon Medical One &bull; {topic.topicLabel}</div>
      <h1>{topic.heroHeading}</h1>
      <p class="lede">{topic.lede}</p>

      <div class="tldr">
        <div class="tldr-label">Short answer</div>
        <p class="tldr-body" set:html={topic.tldr} />
      </div>
    </div>
  </section>

  {topic.sections.map((s) => (
    <section class={s.alt ? "alt" : ""}>
      <div class="wrap">
        <div class="content-block">
          <h2>{s.heading}</h2>
          {s.paragraphs?.map(p => <p set:html={p} />)}
          {s.list && (
            <ul>
              {s.list.map(item => <li set:html={item} />)}
            </ul>
          )}
          {s.specTable && (
            <table class="spec-table">
              <thead>
                <tr><th>Item</th><th>Detail</th></tr>
              </thead>
              <tbody>
                {s.specTable.map(row => (
                  <tr>
                    <td class="label">{row.label}</td>
                    <td set:html={row.value} />
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          {s.note && <p style="font-size:13px;color:#64748b;font-style:italic;margin-top:8px">{s.note}</p>}
        </div>
      </div>
    </section>
  ))}

  <section class="alt">
    <div class="wrap">
      <div class="content-block">
        <h2>Frequently asked questions</h2>
        <div class="faq">
          {topic.faqs.map(f => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p set:html={f.a} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="content-block">
        <h2>Related Dragon Medical One topics</h2>
        <div class="related-grid">
          {topic.relatedTopics.map(r => (
            <a class="related-card" href={r.url}>
              <h4>{r.title} &rarr;</h4>
              <p>{r.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="final-cta" class="cta-section">
    <div class="wrap">
      <div class="cta-grid">
        <div>
          <h2>{topic.ctaHeading}</h2>
          <p>{topic.ctaBody}</p>
          <p style="font-size:14px;color:#cbd5e1;margin-top:12px">Voice Recognition Australia &mdash; Australian Dragon distributor since 1999.</p>
        </div>
        <div>
          <ACForm />
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="footer-inner">
      <div>&copy; {year} {site.siteName}</div>
      <div class="footer-links">
        {site.footerLinks?.map((l) => <a href={l.url}>{l.label}</a>)}
      </div>
    </div>
    <div class="footer-disclaimer">
      Dragon, Dragon Medical One, Dragon Copilot, Nuance, and PowerMic are registered trademarks of Microsoft Corporation or its affiliates. This website is operated by an authorised reseller and is not affiliated with, endorsed by, or sponsored by Microsoft or Nuance Communications except through authorised reseller agreements.
    </div>
  </footer>

</body>
</html>
