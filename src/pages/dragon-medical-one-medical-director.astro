---
import Theme from '../components/Theme.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import site from '../site.config.json';
import ACForm from '../components/ACForm.astro';
const c = site.colours;
const year = new Date().getFullYear();
const emr = site.emrPages.find(e => e.slug === 'dragon-medical-one-medical-director');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{emr.title} | {site.siteName}</title>
  <meta name="description" content={emr.metaDescription} />
  <link rel="canonical" href={`${site.domain}/${emr.slug}`} />
  {site.googleAnalyticsId && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}></script>
    <script define:vars={{ gaId: site.googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  )}
  <Theme />
  <style is:inline>
    .emr-video{padding:0 0 8px}
  </style>
</head>
<body>
  <SiteHeader trialUrl="#emr-cta" />

  <main>
  <section class="page-hero" style="padding-bottom:112px">
    <div class="wrap narrow">
      <a class="crumb" href="/">&larr; Back to {site.siteName}</a>
      <h1>{emr.heroHeading}</h1>
      <p>{emr.heroBody}</p>
      <div class="hero-btns">
        <a class="btn btn-primary btn-lg" href="#emr-cta">Request Free Trial</a>
        <a class="btn btn-secondary btn-lg" href={site.secondaryCTA.url}>{site.secondaryCTA.text}</a>
      </div>
    </div>
  </section>

  <div class="emr-video">
    <div class="wrap narrow">
      <div class="video-outer">
        <div class="yt-facade" data-ytid={emr.youtubeId}>
          <img src={`https://i.ytimg.com/vi/${emr.youtubeId}/maxresdefault.jpg`} alt={`${emr.title} video demonstration`} loading="lazy" decoding="async" />
          <div class="yt-play">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M8 5v14l11-7z"/></svg>
          </div>
        </div>
      </div>
    </div>
    <script>
      document.querySelectorAll('.yt-facade').forEach(function(el) {
        el.addEventListener('click', function() {
          var id = el.dataset.ytid;
          var iframe = document.createElement('iframe');
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          el.innerHTML = '';
          el.appendChild(iframe);
        });
      });
    </script>
  </div>

  <section class="band">
    <div class="wrap narrow">
      <div class="prose">
        <h2>How it works</h2>
        <p>{emr.howItWorks}</p>
        {emr.buyAnchor && <p>{emr.buyBefore}<a href={emr.buyUrl}>{emr.buyAnchor}</a>{emr.buyAfter}</p>}
      </div>
    </div>
  </section>

  <section class="band tint">
    <div class="wrap narrow">
      <h2>Key benefits</h2>
      <ul class="checks">
        {emr.keyBenefits.map(b => <li><span>{b}</span></li>)}
      </ul>
    </div>
  </section>

  <section id="emr-cta" class="band dark">
    <div class="wrap">
      <div class="cta-grid">
        <div>
          <h2>Try Dragon Medical One with {emr.emrName}</h2>
          <p>Tell us about your practice and we will arrange a free trial with remote installation and personalised training.</p>
          <p class="small">Voice Recognition Australia has been distributing Dragon in Australia since 2003. We have the most Dragon Medical One subscribers of any Australian distributor.</p>
        </div>
        <div>
          <ACForm submitText="Request Free Trial" />
        </div>
      </div>
    </div>
  </section>
  </main>

  <SiteFooter>
    Dragon and Dragon Medical One are trademarks of Microsoft Corporation or its affiliates. {emr.emrName} is a trademark of its respective owner. This website is not affiliated with or endorsed by {emr.emrName}.
  </SiteFooter>
</body>
</html>
